   "source": [
    "from sklearn.model_selection import cross_val_score, StratifiedKFold\n",
    "\n",
    "cv5 = StratifiedKFold(n_splits=5, shuffle=True, random_state=0)\n",
    "path = tree.cost_complexity_pruning_path(X_acute, y_acute)\n",
    "\n",
    "rows = []\n",
    "for a in path.ccp_alphas:\n",
    "    m = DecisionTreeClassifier(random_state=0, ccp_alpha=a).fit(X_acute, y_acute)\n",
    "    cv_acc = cross_val_score(DecisionTreeClassifier(random_state=0, ccp_alpha=a),\n",
    "                             X_acute, y_acute, cv=cv5).mean()\n",
    "    rows.append((a, m.get_n_leaves(), m.get_depth(), cv_acc))\n",
    "\n",
    "prune = pd.DataFrame(rows, columns=[\"alpha\", \"leaves\", \"depth\", \"cv_acc\"])\n",
    "prune"
   ]

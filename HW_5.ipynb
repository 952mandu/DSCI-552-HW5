   "source": [
    "cols = [\"temp\", \"nausea\", \"lumbar_pain\", \"urine_pushing\",\n",
    "        \"micturition_pains\", \"burning_urethra\", \"inflammation\", \"nephritis\"]\n",
    "\n",
    "for enc in [\"utf-16\", \"utf-8\", \"latin-1\"]:\n",
    "    try:\n",
    "        acute = pd.read_csv(diag_path, sep=r\"\\s+\", header=None, names=cols,\n",
    "                            encoding=enc, decimal=\",\", engine=\"python\")\n",
    "        if acute.shape == (120, 8):\n",
    "            break\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "acute = acute.replace({\"yes\": 1, \"no\": 0})\n",
    "print(acute.shape)\n",
    "acute.head()"
   ]

    "    XGBRegressor(n_estimators=300, learning_rate=0.05, max_depth=3,\n",
    "                 subsample=0.8, random_state=0),\n",
    "    param_grid={\"reg_alpha\": [0, 0.001, 0.01, 0.1, 1, 10]},\n",
    "    cv=kf, scoring=\"neg_mean_squared_error\",\n",
